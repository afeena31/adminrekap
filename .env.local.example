# Salin file ini jadi ".env.local" (bukan ".env.local.example") lalu isi
# 3 nilai di bawah dari dashboard Supabase project kamu:
# Project Settings -> API

# URL project Supabase kamu (mis. https://xxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" key -- aman dipakai di browser (client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key -- JANGAN PERNAH pakai prefix NEXT_PUBLIC_, dan
# JANGAN PERNAH dipakai di kode yang jalan di browser. Cuma dipakai di
# script migrasi data (Tahap 3) yang jalan di server/terminal kamu sendiri.
SUPABASE_SERVICE_ROLE_KEY=
